# Copy to .env (gitignored). Vite inlines these at build time.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
# Required (absolute http(s) URL of the web app): a production build without it shows "not configured".
VITE_WEB_BASE_URL=http://localhost:3000
# Set to 1 to build against FakeKioskApi (used by `pnpm e2e` via build:e2e).
VITE_FAKE_API=
