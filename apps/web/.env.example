# Copy to .env.local (gitignored). Local values: `supabase status -o env`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Publishable / anon key (safe for the browser; RLS enforces access).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server only, REQUIRED. Never prefix with NEXT_PUBLIC_. Used only by the public download page (/d/<token>);
# the e2e suite also uses it against the LOCAL stack to seed and clean up test rows.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional: largest template upload the form sends, in bytes (default and max 10485760). Vercel Hobby: 4404020.
# NEXT_PUBLIC_TEMPLATE_UPLOAD_MAX_BYTES=10485760
