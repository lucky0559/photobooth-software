# Edge Function secrets (Task 5). Copy to supabase/.env.local for local runs;
# on a hosted project set them with `supabase secrets set`. Never commit real values.
PAYMONGO_SECRET_KEY=sk_test_replace_me
PAYMONGO_WEBHOOK_SECRET=whsk_replace_me
# test | live
PAYMONGO_MODE=test
# Optional. Defaults to https://api.paymongo.com. Local tests point it at the PayMongo stub:
# PAYMONGO_API_BASE=http://host.docker.internal:54399
